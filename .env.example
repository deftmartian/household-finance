HOST=0.0.0.0
PORT=4380
DATA_DIR=/data

# Generic local deployment example.
VLAN_TAG=100
VLAN_TRUNK_INTERFACE=eth0
DNS_SERVER=192.168.1.1

MODEL_NAME=grok-4.5
MODEL_REASONING_EFFORT=high
XAI_API_KEY_FILE=/run/secrets/xai_api_key
XAI_API_KEY_SOURCE=./secrets/xai_api_key.txt
ACTUAL_OIDC_CONFIG_SOURCE=./secrets/actual_oidc_config.json
ACTUAL_SERVER_PASSWORD_SOURCE=./secrets/actual_server_password.txt
ACTUAL_PRODUCTION_CONTRACT_SOURCE=./secrets/actual_production_contract.json
ACTUAL_UPDATE_SIGNING_KEY_SOURCE=./secrets/actual_update_signing_key.txt
ACTUAL_UPDATE_SIGNING_KEY_ID=production-v1
ACTUAL_READ_CONTRACT_SOURCE=./secrets/actual_read_contract.json
NEXTCLOUD_APP_PASSWORD_SOURCE=./secrets/nextcloud_app_password.txt
TALK_BOT_SECRET_SOURCE=./secrets/talk_bot_secret.txt

INTAKE_MODE=disabled
NEXTCLOUD_BASE_URL=https://cloud.example.com
NEXTCLOUD_SERVICE_USER=household-finance-bot
NEXTCLOUD_ARCHIVE_PATH=Finance/Receipts
TALK_ALLOWED_USER_IDS=
TALK_BOT_ACTOR_ID=

# In production mode the complete finance workflow is active: Talk questions,
# household context, receipt and transaction categorization, matching, and
# signed existing-transaction updates. The model never receives ledger credentials.
ACTUAL_READER_URL=http://actual-reader:4370
ACTUAL_BANK_SYNC_INTERVAL_HOURS=4
HOUSEHOLD_TIME_ZONE=UTC
HOUSEHOLD_PROFILE_PATH=Finance/Context/household-profile.json

# Production finance activity is scoped to one explicitly allowlisted Talk room.
HOUSEHOLD_FINANCE_ROOM_TOKEN=
CATEGORY_TAXONOMY_PATH=Finance/Context/category-taxonomy.json
TRANSACTION_CATEGORIZATION_LOOKBACK_DAYS=45
TRANSACTION_CATEGORIZATION_SCAN_INTERVAL_MINUTES=1
# Grok applies a category at or above this threshold and asks one plain
# question below it. This is an operating policy, not a calibrated probability.
TRANSACTION_CATEGORIZATION_MINIMUM_AUTO_APPLY_CONFIDENCE=0.8
# When true, proposed updates are approved automatically and reported in Talk.
# It is rejected unless INTAKE_MODE=production.
ACTUAL_AUTO_APPROVAL_ENABLED=false

ACTUAL_WRITER_POLL_INTERVAL_MS=1000
ACTUAL_WRITER_OPERATION_TIMEOUT_MS=120000
