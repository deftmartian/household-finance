{
  "name": "household-finance",
  "private": true,
  "version": "0.0.1",
  "description": "Self-hosted chat assistant for receipts, transaction categorization, and Actual Budget.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:compose",
    "verify:compose": "bash scripts/verify-compose.sh"
  },
  "dependencies": {
    "@actual-app/api": "26.10.0",
    "better-sqlite3": "13.0.3",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "sharp": "0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^5.0.0"
  }
}
